# ── Anchor Studio Environment Variables ──────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to GitHub.

# Anthropic API key — get yours at https://console.anthropic.com
# This replaces the Cloudflare Worker — Next.js API routes keep this server-side
ANTHROPIC_API_KEY=sk-ant-your-key-here

# API key for chess-club-hub integration — used in /api/generate Authorization header.
# REQUIRED in production: /api/generate fails closed (500) if this is unset, so the
# endpoint is never served unauthenticated.
GENERATE_API_KEY=your-secret-api-key-here

# Durable rate limiting (Upstash Redis REST). Strongly recommended in production —
# without these, rate limiting falls back to a per-instance in-memory store that is
# NOT effective on serverless (each instance/cold start has its own counter).
# Create a free database at https://upstash.com and copy its REST URL + token.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Your site URL (used for CORS and metadata)
NEXT_PUBLIC_SITE_URL=https://www.getanchorstudio.com

# Calendly booking link — replace with your actual link
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-link-here
